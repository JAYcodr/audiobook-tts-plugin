{
  "name": "audiobook-tts-plugin",
  "version": "0.6.5",
  "type": "module",
  "description": "听书值守（Audiobook TTS）：给 Legado（阅读）用的多引擎 TTS 代理 + 值守控制台（支持本地 Qwen3-TTS / OpenAI 兼容 / MiMo 云端 / 混合启动）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "audiobook",
    "tts",
    "legado",
    "mlx",
    "qwen3-tts",
    "openai-tts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAYcodr/audiobook-tts-plugin.git"
  },
  "homepage": "https://github.com/JAYcodr/audiobook-tts-plugin#readme",
  "bugs": {
    "url": "https://github.com/JAYcodr/audiobook-tts-plugin/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./server": "./src/service.mjs",
    "./bin": "./bin/audiobook-tts.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client/",
    "skills/",
    "src/**/*.mjs",
    "bin/*.mjs",
    "tools/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png",
    "docs/*.md",
    "sidecar/server.py",
    "sidecar/requirements.txt",
    "sidecar/README.md",
    "setup/",
    "refs/*.wav"
  ],
  "bin": {
    "audiobook-tts": "bin/audiobook-tts.mjs",
    "mimo-tts": "bin/mimo-tts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/audiobook-tts.mjs",
    "build:client": "node tools/build-client.mjs",
    "preview:ui": "node tools/preview-harness.mjs",
    "lint": "eslint .",
    "check:secrets": "node tools/check-secrets.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm run check:secrets && npm run build:client && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "uqr": "0.1.3",
    "wavesurfer.js": "7.12.12"
  },
  "dependencies": {
    "execa": "9.6.1"
  }
}
