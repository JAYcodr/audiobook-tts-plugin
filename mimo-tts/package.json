{
  "name": "@local/mimo-tts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MiMo TTS 在线听书服务：给 Legado（阅读）用的 TTS 代理 + 值守控制台，一个插件即一个可独立运行的服务。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./server": "./src/service.mjs",
    "./bin": "./bin/mimo-tts.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.template.js",
    "src/*.mjs",
    "src/*.css",
    "bin/*.mjs",
    "tools/*.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png",
    "sidecar/*"
  ],
  "bin": {
    "mimo-tts": "./bin/mimo-tts.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/mimo-tts.mjs",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
